# --- Database (Neon) ---------------------------------------------------------
# Pooled connection — used by the running app. Copy the "Pooled connection"
# string from the Neon dashboard; the host contains "-pooler".
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/hlpl?sslmode=require&pgbouncer=true&connection_limit=1"

# Direct connection — used only by `prisma migrate`. Same string without "-pooler"
# and without the pgbouncer parameters.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/hlpl?sslmode=require"

# --- Auth --------------------------------------------------------------------
# Signs the session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"

# --- Seeding (optional) ------------------------------------------------------
# Initial password for the three seeded users. Defaults to Change@123 if unset.
SEED_PASSWORD=""
