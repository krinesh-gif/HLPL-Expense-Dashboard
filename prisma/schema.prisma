generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection, used by the running app. On Neon this is the "-pooler" host.
  url       = env("DATABASE_URL")
  // Direct, unpooled connection. Migrations need advisory locks that PgBouncer's
  // transaction mode does not support, so they must bypass the pooler.
  directUrl = env("DIRECT_URL")
}

enum Role {
  FOUNDER
  WH
  HO
}

/// Cost centre an expense belongs to. FOUNDER = spends made directly by the founder.
enum CostCenter {
  WH
  HO
  FOUNDER
}

/// The two ways money actually leaves: physical cash, or anything electronic.
/// This is the vocabulary the team already used in the old sheets.
enum PaymentMode {
  CASH
  ONLINE
}

/// Money moving in and out of the founder's cash chest.
/// A hand-over of cash needs both sides to agree before it counts.
enum TransferStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum CashTxnType {
  RECEIPT /// cash coming in to the founder (supplier refund, billing recovery, sales collection)
  ISSUE   /// founder hands cash to a cost centre float (WH / HO)
  DRAWING /// director drawing - money out of the business, not a business expense
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role
  costCenter   CostCenter?
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())

  expenses     Expense[]       @relation("EnteredBy")
  approvals    Expense[]       @relation("ApprovedBy")
  cashTxns     CashTxn[]
  confirmedCash CashTxn[]  @relation("ConfirmedCash")
  counts       CashCount[]
  pushSubs     PushSubscription[]
}

/// Expense category master. One canonical taxonomy shared by all three teams.
model Category {
  id           String       @id @default(cuid())
  code         String       @unique
  name         String
  group        String       /// P&L grouping, e.g. "Logistics", "Manpower", "Facility"
  tallyLedger  String       /// ledger name to post against in Tally
  costCenters  CostCenter[] /// which teams may book to this head
  /// emoji shown before the name, e.g. "📦"
  icon         String       @default("🔖")
  /// palette key resolved in src/lib/palette.ts, e.g. "blue"
  color        String       @default("slate")
  monthlyBudget Decimal?    @db.Decimal(12, 2)
  requiresBill Boolean      @default(false)
  billThreshold Decimal?    @db.Decimal(12, 2) /// bill required above this amount
  isCapex      Boolean      @default(false)
  active       Boolean      @default(true)
  sortOrder    Int          @default(100)

  expenses     Expense[]
  aliases      CategoryAlias[]

  @@index([active, sortOrder])
}

/// Maps the free-text category names used in the old sheets onto the master.
model CategoryAlias {
  id         String   @id @default(cuid())
  alias      String   @unique
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model Expense {
  id          String      @id @default(cuid())
  date        DateTime    @db.Date
  costCenter  CostCenter
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  amount      Decimal     @db.Decimal(12, 2)
  paymentMode PaymentMode @default(CASH)
  paidTo      String?
  description String?
  billNo      String?
  attachmentUrl String?

  enteredById String
  enteredBy   User        @relation("EnteredBy", fields: [enteredById], references: [id])

  approvedById String?
  approvedBy   User?      @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  /// set when an entry is reversed; reversed rows are excluded from every total
  voidedAt     DateTime?
  voidReason   String?

  legacyRef   String?     /// provenance of rows migrated from the old workbooks
  /// Generated on the device before the entry is sent. An entry made offline may be
  /// retried several times before it lands; this makes the write idempotent so a
  /// flaky warehouse connection cannot record the same spend twice.
  clientId    String?     @unique
  createdAt   DateTime    @default(now())

  @@index([costCenter, date])
  @@index([categoryId, date])
  @@index([date])
}

model CashTxn {
  id          String      @id @default(cuid())
  date        DateTime    @db.Date
  type        CashTxnType
  amount      Decimal     @db.Decimal(12, 2)
  /// RECEIPT: where the cash came from. ISSUE: which float it went to. DRAWING: which director.
  source      String?
  toCostCenter CostCenter?
  mode        PaymentMode @default(CASH)
  note        String?

  createdById String
  createdBy   User        @relation(fields: [createdById], references: [id])

  /// Only ISSUE transfers between the founder and a team are confirmed by the other
  /// side. Everything else (receipts into the founder's chest, drawings, a team's own
  /// scrap sale) is settled the moment it is recorded and stays CONFIRMED.
  status       TransferStatus @default(CONFIRMED)
  /// Which side recorded it, so each side is asked to confirm the other's claim.
  initiatedBy  Role?
  confirmedById String?
  confirmedBy   User?      @relation("ConfirmedCash", fields: [confirmedById], references: [id])
  confirmedAt   DateTime?
  rejectedReason String?

  voidedAt    DateTime?
  legacyRef   String?
  createdAt   DateTime    @default(now())

  @@index([type, date])
  @@index([toCostCenter, date])
  @@index([status, toCostCenter])
}

/// A device signed up for reminder notifications. One row per browser install.
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  /// cleared whenever a send succeeds; used to drop dead subscriptions
  failures  Int      @default(0)

  @@index([userId])
}

/// Physical cash count declared by a team, to reconcile against the system float balance.
model CashCount {
  id           String     @id @default(cuid())
  date         DateTime   @db.Date
  costCenter   CostCenter
  countedAmount Decimal   @db.Decimal(12, 2)
  systemAmount  Decimal   @db.Decimal(12, 2)
  variance      Decimal   @db.Decimal(12, 2)
  note         String?
  countedById  String
  countedBy    User       @relation(fields: [countedById], references: [id])
  createdAt    DateTime   @default(now())

  @@index([costCenter, date])
}
